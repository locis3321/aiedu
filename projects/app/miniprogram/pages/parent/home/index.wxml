<view class="card">
  <view style="font-size:22px;font-weight:750">家庭概览</view>
  <view class="tiny" style="margin-top:6px">{{loginNote}}</view>
  <input placeholder="手机号" bindinput="onPhone" style="border:1px solid #eadfba;border-radius:12px;padding:10px;margin-top:10px"/>
  <input placeholder="验证码（dev=123456）" bindinput="onCode" style="border:1px solid #eadfba;border-radius:12px;padding:10px;margin-top:8px"/>
  <button class="btn" bindtap="sendCode" style="margin-top:10px">发送验证码</button>
  <button class="btn secondary" bindtap="login" style="margin-top:8px">登录（短信 dev）</button>
</view>