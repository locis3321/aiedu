# Copy to .env and fill in real values locally; never commit .env.
#
# 标注说明：
#   [必须环境变量] 只能通过环境变量配置（基础设施/根密钥/登录门禁，放库里有循环或安全风险）
#   [后台可配置] 可在运营后台"模型/TTS/系统参数/凭据"面板配置（DB 优先，此处为部署默认值）

# --- 运行环境 --- [必须环境变量]
# development：短信无凭据时走 dev 固定验证码；production：默认 SECRET_KEY 拒绝启动、
# 短信无凭据显式 503（不 dev 兜底）。生产必须设为 production。
APP_ENV=development

# --- PostgreSQL (compose service `postgres`) --- [必须环境变量]
DATABASE_URL=postgresql+psycopg://aiedu:aiedu@127.0.0.1:5432/aiedu

# --- Redis / Celery broker (compose maps host port to container's 6379) --- [必须环境变量]
REDIS_URL=redis://127.0.0.1:6380/0

# --- Object storage --- [后台可配置：系统参数/凭据面板]
# Dev default is the local-disk adapter; set STORAGE_BACKEND=s3 to use an S3-compatible target (e.g. MinIO).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/artifacts
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=aiedu-artifacts
S3_ACCESS_KEY=<S3_ACCESS_KEY>
S3_SECRET_KEY=<S3_SECRET_KEY>

# --- LLM (OpenAI-compatible; values are injected by the environment) --- [后台可配置：模型配置面板，密钥加密入库]
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
# EMBED_* 目前无消费点（死配置），保留仅为兼容
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL_NAME=
EMBED_RERANKER_MODEL_NAME=

# --- Accounts (T2) ---
# JWT signing key: dev default is insecure; MUST override in production. [必须环境变量]
SECURITY_SECRET_KEY=dev-only-insecure-secret-change-me
# 凭据加密密钥（Fernet 派生材料）：建议与 JWT 密钥拆分，避免 JWT 轮换连带凭据不可解密。
# 未配置时回退 SECURITY_SECRET_KEY（向后兼容）。[必须环境变量/生产建议]
CREDENTIAL_ENCRYPTION_KEY=
# Token 有效期可在运营后台"系统参数"面板配置 [后台可配置]
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CHILD_TOKEN_EXPIRE_MINUTES=720

# 运营后台开发态登录（无凭据签发管理 token）：仅本地开发设 true；生产必须 false/缺省（接 SSO）[必须环境变量]
ADMIN_DEV_LOGIN_ENABLED=false

# TTS（MiMo-V2.5-TTS，小米平台）：key 可在后台"凭据"面板配置（加密入库）[后台可配置]
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts

# --- 观测（Tempo/Grafana，compose 已含） --- [必须环境变量/可选]
# AIEDU_TRACE=0 关闭 OTel 导出；默认导出到 OTLP 4317
AIEDU_TRACE=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=aiedu-backend
# Grafana 基址（Trace 跳转）[后台可配置：系统参数面板，仅允许 http(s)://]
GRAFANA_BASE_URL=http://127.0.0.1:3000

# SMS verification code (dev fallback + anti-abuse)
# SMS_DEV_FIXED_CODE 仅开发兜底（APP_ENV=development 时生效；生产无凭据显式 503）[必须环境变量]
# 防刷参数可在后台"系统参数"面板配置 [后台可配置]
SMS_DEV_FIXED_CODE=123456
SMS_CODE_TTL_SECONDS=300
SMS_CODE_MAX_ATTEMPTS=5
SMS_SEND_COOLDOWN_SECONDS=60
SMS_MAX_PER_DAY_PER_PHONE=10

# Tencent Cloud SMS: leave empty → APP_ENV=development 时走 dev fallback；
# APP_ENV=production 时显式 503（不假成功）。
# With ak/sk set but sign/template empty, the API explicitly reports 未接入.
# ak/sk/SDKAppID 可在后台"凭据"面板配置（加密入库）[后台可配置]；签名/模板 ID 在"短信模板"面板
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# WeChat mini-program login: leave empty to explicitly report 未接入. [后台可配置：凭据面板]
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- Tizhuang question bank (third-party source, anonymous trial) --- [后台可配置：系统参数面板]
QUESTION_SERVICE_URL=https://tizhuang.qcscience.cc/api
