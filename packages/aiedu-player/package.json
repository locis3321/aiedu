{
  "name": "@aiedu/player",
  "version": "0.1.0",
  "description": "数芽课堂渲染器：LessonSpec v2 → 可交互课堂（纯浏览器侧 API + 静态渲染服务）",
  "private": false,
  "type": "module",
  "main": "./dist/player.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/player.js"
    }
  },
  "files": [
    "dist",
    "src",
    "templates",
    "server"
  ],
  "scripts": {
    "build": "vite build",
    "serve": "node server/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
