          "type": "array"
        },
        "model_refs": {
          "items": {
            "type": "string"
          },
          "title": "Model Refs",
          "type": "array"
        },
        "representation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Representation Refs",
          "type": "array"
