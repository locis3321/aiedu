{
  "$defs": {
    "AssessmentItem": {
      "description": "按学习目标定义评价证据、答案规则或论证量规。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "objective_refs": {
          "items": {
            "type": "string"
          },
          "title": "Objective Refs",
          "type": "array"
        },
        "evidence_kind": {
          "enum": [
            "numeric_answer",
            "expression",
            "classification",
            "construction",
            "proof_step",
            "explanation",
            "dataset"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "rubric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Rubric Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "evidence_kind"
      ],
      "title": "AssessmentItem",
      "type": "object"
    },
    "ClaimEvidence": {
      "description": "单条数学主张的核验证据。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "refuted",
            "inconclusive",
            "requires_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "method": {
          "description": "证据类型：精确计算 / 形式推导 / 数值实验 / 教研审核等",
          "minLength": 1,
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "status",
        "method"
      ],
      "title": "ClaimEvidence",
      "type": "object"
    },
    "ConstructNode": {
      "description": "构造节点：完成满足约束的构造（几何作图、表达式构造等）。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "construct",
          "title": "Type",
          "type": "string"
        },
        "objective_refs": {
          "items": {
            "type": "string"
          },
          "title": "Objective Refs",
          "type": "array"
        },
        "model_refs": {
          "items": {
            "type": "string"
          },
          "title": "Model Refs",
          "type": "array"
        },
        "representation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Representation Refs",
          "type": "array"
        },
        "completion_refs": {
          "description": "完成条件引用的 assessment id",
          "items": {
            "type": "string"
          },
          "title": "Completion Refs",
          "type": "array"
        },
        "next_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "后继 step ID；None 或 ['__end__'] 表示结束",
          "title": "Next Ids"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "response": {
          "discriminator": {
            "mapping": {
              "choice": "#/$defs/ResponseChoice",
              "construction": "#/$defs/ResponseConstruction",
              "dataset": "#/$defs/ResponseDataset",
              "explanation": "#/$defs/ResponseExplanation",
              "expression": "#/$defs/ResponseExpression",
              "manipulation": "#/$defs/ResponseManipulation",
              "number": "#/$defs/ResponseNumber",
              "proof_step": "#/$defs/ResponseProofStep"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ResponseChoice"
            },
            {
              "$ref": "#/$defs/ResponseNumber"
            },
            {
              "$ref": "#/$defs/ResponseExpression"
            },
            {
              "$ref": "#/$defs/ResponseConstruction"
            },
            {
              "$ref": "#/$defs/ResponseManipulation"
            },
            {
              "$ref": "#/$defs/ResponseProofStep"
            },
            {
              "$ref": "#/$defs/ResponseExplanation"
            },
            {
              "$ref": "#/$defs/ResponseDataset"
            }
          ],
          "title": "Response"
        },
        "gate": {
          "$ref": "#/$defs/Gate"
        },
        "on_correct": {
          "items": {
            "type": "string"
          },
          "title": "On Correct",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "prompt",
        "response",
        "gate"
      ],
      "title": "ConstructNode",
      "type": "object"
    },
    "DomainModelDef": {
      "description": "领域模型声明：带领域名与插件版本。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "plugin_version": {
          "minLength": 1,
          "title": "Plugin Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "plugin_version"
      ],
      "title": "DomainModelDef",
      "type": "object"
    },
    "ExplainNode": {
      "description": "解释节点：开放回答保留量规与不确定性，不强行压成单一布尔正确。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "explain",
