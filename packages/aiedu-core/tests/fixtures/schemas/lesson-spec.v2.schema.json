          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "narration"
      ],
      "title": "ObserveNode",
      "type": "object"
    },
    "OperationDef": {
      "description": "命名空间领域操作，例如 arithmetic.transfer_units。",
      "properties": {
        "id": {
          "description": "命名空间操作 ID，如 arithmetic.transfer_units",
          "examples": [
            "arithmetic.transfer_units"
          ],
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "OperationDef",
      "type": "object"
    },
