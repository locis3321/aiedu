        "completion_refs": {
          "description": "完成条件引用的 assessment id",
          "items": {
            "type": "string"
          },
          "title": "Completion Refs",
          "type": "array"
        },
        "next_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "后继 step ID；None 或 ['__end__'] 表示结束",
          "title": "Next Ids"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "rubric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Rubric Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "prompt"
      ],
      "title": "ExplainNode",
      "type": "object"
    },
    "Gate": {
      "description": "解锁门槛：由教学目标决定，不强制全课预测优先。",
      "properties": {
        "mode": {
          "enum": [
            "require_attempt",
            "require_correct_or_assisted",
            "learner_continue",
            "exploration_condition"
          ],
          "title": "Mode",
          "type": "string"
        },
        "max_assists": {
          "default": 3,
          "minimum": 0,
          "title": "Max Assists",
          "type": "integer"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Gate",
      "type": "object"
    },
    "LearningObjective": {
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
